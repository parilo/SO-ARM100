        <geom type="mesh" rgba="0.792157 0.819608 0.933333 1" mesh="Rotation_Pitch" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
        <geom type="mesh" rgba="0.792157 0.819608 0.933333 1" mesh="Rotation_Pitch" />
        <body name="Upper_Arm" pos="0 0.1025 0.0306" quat="0.707105 0.707108 0 0">
          <inertial pos="-1.72052e-05 0.0701802 0.00310545" quat="0.50104 0.498994 -0.493562 0.50632" mass="0.162409" diaginertia="0.000213312 0.000167164 7.01522e-05" />
          <joint name="Pitch" pos="0 0 0" axis="-1 0 0" range="0 3.4" actuatorfrcrange="-200 200" />
