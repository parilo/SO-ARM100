                  <inertial pos="-0.00161745 -0.0303473 0.000449646" quat="0.696562 0.716737 -0.0239844 -0.0227026" mass="0.0202444" diaginertia="1.11265e-05 8.99651e-06 2.99548e-06" />
                  <joint name="Jaw" pos="0 0 0" axis="0 0 1" range="0 1.57" actuatorfrcrange="-200 200" />
                  <geom type="mesh" rgba="0.792157 0.819608 0.933333 1" mesh="Moving Jaw" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
