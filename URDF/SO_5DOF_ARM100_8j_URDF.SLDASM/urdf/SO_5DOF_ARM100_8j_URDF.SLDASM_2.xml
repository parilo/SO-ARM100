              <joint name="Wrist_Pitch" pos="0 0 0" axis="1 0 0" range="-1.57 1.57" actuatorfrcrange="-200 200" />
              <geom type="mesh" rgba="0.792157 0.819608 0.933333 1" mesh="Wrist_Pitch_Roll" contype="1" conaffinity="0" density="0" group="1" class="visualgeom" />
              <geom type="mesh" rgba="0.792157 0.819608 0.933333 1" mesh="Wrist_Pitch_Roll" />
