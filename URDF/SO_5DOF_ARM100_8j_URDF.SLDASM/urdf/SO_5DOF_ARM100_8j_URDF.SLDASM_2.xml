                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="Rotation" joint="Rotation" ctrllimited="true" ctrlrange="-200 200" gear="1" />
    <motor name="Pitch" joint="Pitch" ctrllimited="true" ctrlrange="-200 200" gear="1" />
    <motor name="Elbow" joint="Elbow" ctrllimited="true" ctrlrange="-200 200" gear="1" />
    <motor name="Wrist_Pitch" joint="Wrist_Pitch" ctrllimited="true" ctrlrange="-200 200" gear="1" />
    <motor name="Wrist_Roll" joint="Wrist_Roll" ctrllimited="true" ctrlrange="-200 200" gear="1" />
    <!-- <motor name="Jaw" joint="Jaw" ctrllimited="true" ctrlrange="-200 200" gear="1" /> -->
  </actuator>

  <sensor>
    <actuatorpos name="Rotation_p" actuator="Rotation" />
    <actuatorvel name="Rotation_v" actuator="Rotation" />
    <actuatorfrc name="Rotation_f" actuator="Rotation" noise="0.001" />
    <actuatorpos name="Pitch_p" actuator="Pitch" />
    <actuatorvel name="Pitch_v" actuator="Pitch" />
    <actuatorfrc name="Pitch_f" actuator="Pitch" noise="0.001" />
    <actuatorpos name="Elbow_p" actuator="Elbow" />
    <actuatorvel name="Elbow_v" actuator="Elbow" />
    <actuatorfrc name="Elbow_f" actuator="Elbow" noise="0.001" />
    <actuatorpos name="Wrist_Pitch_p" actuator="Wrist_Pitch" />
    <actuatorvel name="Wrist_Pitch_v" actuator="Wrist_Pitch" />
    <actuatorfrc name="Wrist_Pitch_f" actuator="Wrist_Pitch" noise="0.001" />
    <actuatorpos name="Wrist_Roll_p" actuator="Wrist_Roll" />
    <actuatorvel name="Wrist_Roll_v" actuator="Wrist_Roll" />
    <actuatorfrc name="Wrist_Roll_f" actuator="Wrist_Roll" noise="0.001" />
    <!-- <actuatorpos name="Jaw_p" actuator="Jaw" />
    <actuatorvel name="Jaw_v" actuator="Jaw" />
    <actuatorfrc name="Jaw_f" actuator="Jaw" noise="0.001" /> -->
    <framequat name="orientation" objtype="site" noise="0.001" objname="imu" />
    <gyro name="angular-velocity" site="imu" noise="0.005" cutoff="34.9" />
  </sensor>
</mujoco>