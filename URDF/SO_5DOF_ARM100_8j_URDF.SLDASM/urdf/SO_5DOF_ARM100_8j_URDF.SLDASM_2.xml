      <geom type="mesh" rgba="0.792157 0.819608 0.933333 1" mesh="Base" quat="0.707105 0 0 0.707108" />
      <body name="Rotation_Pitch" pos="0.0452 1.66029e-07 0.0165" quat="0.499998 0.5 0.500002 0.5">
        <inertial pos="-9.07886e-05 0.0590972 0.031089" quat="0.363978 0.441169 -0.623108 0.533504" mass="0.119226" diaginertia="5.94278e-05 5.89975e-05 3.13712e-05" />
